# ==============================================================================
# StorageVault - Environment Configuration Example
# Copy this file to .env and configure with your actual credentials.
# NEVER commit real credentials or session tokens to Git.
# ==============================================================================

# Port & Base URL
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/storagevault?schema=public"

# If testing locally without PostgreSQL, you can also use SQLite for quick evaluation:
# DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (generate using: openssl rand -base64 32)
JWT_SECRET="storagevault-super-secret-jwt-key-replace-in-production-min-32-chars!"

# Session Encryption Key for Telegram MTProto StringSessions (32-byte hex for AES-256-GCM)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 64 random hex characters. Generate with: openssl rand -hex 32
# DO NOT use a guessable or published value here — this key encrypts Telegram
# session strings at rest. If this key was ever committed with a real value,
# rotate it and re-encrypt all stored sessions.
ENCRYPTION_KEY="PASTE_A_FRESH_64_HEX_CHAR_SECRET_HERE"

# Telegram MTProto Credentials
# Obtain your API ID and API HASH from https://my.telegram.org (under 'API development tools')
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH="your_telegram_api_hash_here"

# Telegram Mode: "real" to use live Telegram MTProto servers, or "mock" for offline testing/evaluation
TELEGRAM_MODE="mock"

# AI Configuration (Privacy-Compliant: No training, no persistent memory, strictly ephemeral)
# Options: "gemini", "openai", "local" (deterministic parser fallback)
AI_PROVIDER="local"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Upload Constraints
MAX_FILE_SIZE_BYTES=2097152000 # 2GB default Telegram file limit
# Chunked uploads: files bigger than 2GB are auto-split into 512MB chunks.
MAX_CHUNKED_FILE_SIZE_BYTES=53687091200 # 50GB total cap for chunked uploads
TEMP_UPLOAD_DIR="./tmp/uploads"

# SMTP / Email Delivery (for password-reset emails)
# Leave SMTP_HOST empty to disable email sending: the reset link is then
# logged server-side instead (safe for local dev). Configure these in
# production so users actually receive reset emails.
SMTP_HOST=""          # e.g. smtp.gmail.com (empty = email disabled)
SMTP_PORT=587         # 587 (STARTTLS) or 465 (SSL)
SMTP_SECURE=""        # set to "true" to force SSL; auto-detects 465 otherwise
SMTP_USER=""          # SMTP username (often the sender email address)
SMTP_PASS=""          # SMTP password or app-specific password
SMTP_FROM=""          # Sender address shown to recipients, e.g. "StorageVault <no-reply@example.com>"
