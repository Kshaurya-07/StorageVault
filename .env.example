# ==============================================================================
# StorageVault - Environment Configuration Example
# Copy this file to .env and configure with your actual credentials.
# NEVER commit real credentials or session tokens to Git.
# ==============================================================================

# Port & Base URL
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vault_ai?schema=public"

# If testing locally without PostgreSQL, you can also use SQLite for quick evaluation:
# DATABASE_URL="file:./dev.db"

# JWT Authentication Secret (generate using: openssl rand -base64 32)
JWT_SECRET="vault-ai-super-secret-jwt-key-replace-in-production-min-32-chars!"

# Session Encryption Key for Telegram MTProto StringSessions (32-byte hex for AES-256-GCM)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Telegram MTProto Credentials
# Obtain your API ID and API HASH from https://my.telegram.org (under 'API development tools')
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH="your_telegram_api_hash_here"

# Telegram Mode: "real" to use live Telegram MTProto servers, or "mock" for offline testing/evaluation
TELEGRAM_MODE="mock"

# AI Configuration (Privacy-Compliant: No training, no persistent memory, strictly ephemeral)
# Options: "gemini", "openai", "local" (deterministic parser fallback)
AI_PROVIDER="local"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Upload Constraints
MAX_FILE_SIZE_BYTES=2097152000 # 2GB default Telegram file limit
TEMP_UPLOAD_DIR="./tmp/uploads"
